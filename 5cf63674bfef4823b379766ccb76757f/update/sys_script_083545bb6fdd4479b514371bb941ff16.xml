        <collection>x_2053322_smartnes_task</collection>
        <condition>current.status.changesTo('Completed') &amp;&amp; current.task_type == 'Preventive Maintenance' &amp;&amp; !current.asset_ref.nil()</condition>
        <description/>
        <execute_function>false</execute_function>
        <filter_condition/>
        <is_rest>false</is_rest>
        <message/>
        <name>SmartNest: PM Completion Sync</name>
        <order/>
        <priority/>
        <rest_method/>
        <rest_method_text/>
        <rest_service/>
        <rest_service_text/>
        <rest_variables/>
        <role_conditions/>
        <script><![CDATA[
      var assetGr = new GlideRecord('x_2053322_smartnes_asset');
      if (assetGr.get(current.getValue('asset_ref'))) {
        var freq = parseInt(assetGr.maintenance_frequency_days, 10);
        if (isNaN(freq)) freq = 30; // default 30 days
        
        var gdt = new GlideDateTime();
        assetGr.last_maintenance = gdt;
        
        gdt.addDaysUTC(freq);
        assetGr.next_maintenance = gdt;
        
        assetGr.recurring_failure_risk = false; // Reset risk upon full PM
        assetGr.update();
      }
    ]]></script>
